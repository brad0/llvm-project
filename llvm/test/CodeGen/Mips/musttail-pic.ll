; Test musttail calls to functions that may be preempted. O32 has $gp
; call-clobbered, so these can be tail called in PIC code. Non-PIC code does
; not use $gp for calls. N32/N64 PIC is tested in
; musttail-preemptible.ll.

declare i32 @external(i32)

define i32 @test_external(i32 %x) {
; O32-PIC-LABEL: test_external:
; O32-PIC:       # %bb.0:
; O32-PIC-NEXT:    lui $2, %hi(_gp_disp)
; O32-PIC-NEXT:    addiu $2, $2, %lo(_gp_disp)
; O32-PIC-NEXT:    addu $gp, $2, $25
; O32-PIC-NEXT:    lw $25, %call16(external)($gp)
; O32-PIC-NEXT:    .reloc $tmp0, R_MIPS_JALR, external
; O32-PIC-NEXT:  $tmp0:
; O32-PIC-NEXT:    jr $25
; O32-PIC-NEXT:    nop
;
; O32-STATIC-LABEL: test_external:
; O32-STATIC:       # %bb.0:
; O32-STATIC-NEXT:    j external
; O32-STATIC-NEXT:    nop
;
; N64-STATIC-LABEL: test_external:
; N64-STATIC:       # %bb.0:
; N64-STATIC-NEXT:    j external
; N64-STATIC-NEXT:    nop
  %ret = musttail call i32 @external(i32 %x)
  ret i32 %ret
}

